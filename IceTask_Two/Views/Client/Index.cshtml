@model IEnumerable<IceTask_Two.Models.Client>
@{
    ViewData["Title"] = "Clients";
    string searchVal = ViewBag.Search as string ?? "";
}

<h1 class="mb-3">Clients</h1>

<form asp-action="Index" method="get" class="row g-2 mb-3 border rounded p-3 bg-light">
    <div class="col-md-8">
        <label class="form-label">Search (name, contact, or email)</label>
        <input class="form-control" type="text" name="search" value="@searchVal" placeholder="Type to filter..." />
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <button type="submit" class="btn btn-primary me-2">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<p>
    <a class="btn btn-primary" asp-action="Create">Add client</a>
</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Name)</th>
            <th>@Html.DisplayNameFor(m => m.ContactPerson)</th>
            <th>@Html.DisplayNameFor(m => m.Email)</th>
            <th>@Html.DisplayNameFor(m => m.Phone)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@if (!Model.Any())
{
        <tr>
            <td colspan="5" class="text-muted">No clients match your search.</td>
        </tr>
}
@foreach (var item in Model)
{
        <tr>
            <td>@Html.DisplayFor(m => item.Name)</td>
            <td>@Html.DisplayFor(m => item.ContactPerson)</td>
            <td>@Html.DisplayFor(m => item.Email)</td>
            <td>@Html.DisplayFor(m => item.Phone)</td>
            <td class="text-nowrap">
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
