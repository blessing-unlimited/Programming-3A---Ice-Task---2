@model IceTask_Two.Models.Contract
@{
    ViewData["Title"] = "Contract details";
    var nextSteps = IceTask_Two.Models.ContractWorkflow.GetNextStatuses(Model.Status);
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<h1>@Model.Title</h1>

<p><strong>Status:</strong> @Model.Status</p>
<p><strong>Client:</strong> @(Model.Client != null ? Model.Client.Name : "")</p>
<p><strong>Description:</strong> @Model.Description</p>
<p><strong>Start:</strong> @Model.StartDate.ToString("yyyy-MM-dd")</p>
<p><strong>End:</strong> @Model.EndDate.ToString("yyyy-MM-dd")</p>

<hr />
<h2>Change status</h2>
<p>Pick the next step (only allowed moves are shown).</p>

@if (nextSteps.Count == 0)
{
    <p class="text-muted">No changes allowed from this status.</p>
}
else
{
    @foreach (var step in nextSteps)
    {
        <form asp-action="ChangeStatus" method="post" style="display:inline-block; margin-right:8px; margin-bottom:8px;">
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="newStatus" value="@((int)step)" />
            <button type="submit" class="btn btn-outline-primary">@step</button>
        </form>
    }
}

<p class="mt-3">
    <a asp-action="Index">Back to list</a>
</p>
